APP_NAME=AIxRWA Agent
APP_ENV=local
API_PORT=8000
RUNTIME_MODE=monitor_only
TARGET_CHAIN=mantle_sepolia

LOG_ENABLED=true
LOG_LEVEL=INFO
LOG_MARKET_DATA=INFO
LOG_ORACLE=INFO
LOG_QUOTES=INFO
LOG_RISK=DEBUG
LOG_ALLOCATION=INFO
LOG_AI=INFO
LOG_PROPOSALS=DEBUG
LOG_EXECUTION=DEBUG
LOG_ALERTS=INFO
LOG_DB=WARNING

MANTLE_MAINNET_CHAIN_ID=5000
MANTLE_SEPOLIA_CHAIN_ID=5003
MANTLE_MAINNET_RPC_URL=https://rpc.mantle.xyz
MANTLE_SEPOLIA_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_MAINNET_QUICKNODE_HTTP_URL=
MANTLE_MAINNET_QUICKNODE_WSS_URL=
MANTLE_SEPOLIA_QUICKNODE_HTTP_URL=replace_with_quicknode_https_url
MANTLE_SEPOLIA_QUICKNODE_WSS_URL=replace_with_quicknode_wss_url

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aixrwa
REDIS_URL=
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_HERMES_LATEST_PRICE_PATH=/v2/updates/price/latest
PRICE_POLL_INTERVAL_SECONDS=60
QUOTE_POLL_INTERVAL_SECONDS=30
ROUTE_CACHE_TTL_SECONDS=60
ORACLE_MAX_AGE_SECONDS_DEFAULT=300
ORACLE_MAX_AGE_SECONDS_STABLE=600
ORACLE_MAX_AGE_SECONDS_VOLATILE=120

PYTH_MAINNET_CONTRACT=
PYTH_SEPOLIA_CONTRACT=
