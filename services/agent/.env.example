ONDO_USDY_ORACLE_FRESH_LIMIT_SECONDS=600
ONDO_USDY_ORACLE_WARN_SECONDS=300
ONDO_USDY_ORACLE_HARD_BLOCK_SECONDS=600
DEX_QUOTE_FRESH_LIMIT_SECONDS=30
DEX_QUOTE_WARN_SECONDS=15
DEX_QUOTE_HARD_BLOCK_SECONDS=30
ROUTE_DEPTH_FRESH_LIMIT_SECONDS=60
ROUTE_DEPTH_WARN_SECONDS=60
ROUTE_DEPTH_HARD_BLOCK_SECONDS=120
PORTFOLIO_BALANCE_FRESH_LIMIT_SECONDS=60
PORTFOLIO_BALANCE_WARN_SECONDS=60
PORTFOLIO_BALANCE_HARD_BLOCK_SECONDS=180
RISK_SNAPSHOT_FRESH_LIMIT_SECONDS=60
