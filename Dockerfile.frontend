FROM node:20-alpine

WORKDIR /workspace/frontend

COPY frontend/package*.json ./
RUN npm install --legacy-peer-deps

COPY frontend/ ./

# Build-time env vars Vite needs to bake into the bundle
ARG VITE_API_BASE_URL
ARG VITE_LOG_LEVEL
ARG VITE_WALLETCONNECT_PROJECT_ID
ARG VITE_MANTLE_SEPOLIA_QUICKNODE_HTTP_URL
ARG VITE_MANTLE_SEPOLIA_RPC_URL

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_LOG_LEVEL=$VITE_LOG_LEVEL
ENV VITE_WALLETCONNECT_PROJECT_ID=$VITE_WALLETCONNECT_PROJECT_ID
ENV VITE_MANTLE_SEPOLIA_QUICKNODE_HTTP_URL=$VITE_MANTLE_SEPOLIA_QUICKNODE_HTTP_URL
ENV VITE_MANTLE_SEPOLIA_RPC_URL=$VITE_MANTLE_SEPOLIA_RPC_URL

RUN npm run build

EXPOSE 8080

CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "8080"]